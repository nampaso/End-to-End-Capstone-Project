import sqlite3
import matplotlib.pyplot as plt
import pandas as pd
import seaborn as sns

sns.set_theme(style="whitegrid")

with sqlite3.connect("../data/duka_electronics.db") as conn:
    df = pd.read_sql("""
        SELECT t.*, p.product_name, p.category, c.city, c.loyalty_tier
        FROM transactions t
        JOIN products p ON t.product_id = p.product_id
        JOIN customers c ON t.customer_id = c.customer_id
        WHERE t.order_status = 'Completed'
    """, conn)

# Univariate
display(df[["quantity", "unit_price_kes", "discount_pct", "gross_revenue_kes", "gross_profit_kes"]].describe().round(2))

fig, ax = plt.subplots(figsize=(8, 4))
sns.histplot(df["gross_revenue_kes"], bins=30, kde=True, ax=ax)
ax.set_title("Distribution of Order Revenue (KES)")
ax.set_xlabel("Gross Revenue (KES)")
plt.tight_layout()
plt.show()

# Bivariate: Monthly revenue by branch
monthly = df.groupby(["order_month", "branch"], as_index=False)["gross_revenue_kes"].sum()
fig, ax = plt.subplots(figsize=(9, 4.5))
sns.lineplot(data=monthly, x="order_month", y="gross_revenue_kes", hue="branch", marker="o", ax=ax)
ax.set_title("Monthly Net Revenue by Branch (H1 2026)")
ax.set_xlabel("Month")
ax.set_ylabel("Net Revenue (KES)")
plt.tight_layout()
plt.show()

# Segmentation: Branch x Category revenue (KES Millions)
pivot = df.pivot_table(index="branch", columns="category", values="gross_revenue_kes", aggfunc="sum") / 1e6
fig, ax = plt.subplots(figsize=(8, 4.5))
sns.heatmap(pivot, annot=True, fmt=".2f", cmap="Blues", ax=ax)
ax.set_title("Net Revenue by Branch and Category (KES Millions)")
plt.tight_layout()
plt.show()
