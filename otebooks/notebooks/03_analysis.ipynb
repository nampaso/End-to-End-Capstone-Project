import os
import sqlite3
import pandas as pd
from scipy import stats

with open("../sql/queries.sql", "r", encoding="utf-8") as f:
    sql_text = f.read()

statements = [s.strip() for s in sql_text.split(";") if "SELECT" in s.upper()]

with sqlite3.connect("../data/duka_electronics.db") as conn:
    for idx, stmt in enumerate(statements, 1):
        print(f"=== Query {idx} ===")
        display(pd.read_sql(stmt, conn))

    completed = pd.read_sql("""
        SELECT t.*, p.category, c.loyalty_tier
        FROM transactions t
        JOIN products p ON t.product_id = p.product_id
        JOIN customers c ON t.customer_id = c.customer_id
        WHERE t.order_status = 'Completed'
    """, conn)
    all_tx = pd.read_sql("SELECT * FROM transactions", conn)

total_rev = completed["gross_revenue_kes"].sum()
total_profit = completed["gross_profit_kes"].sum()
orders_cnt = len(completed)
aov = total_rev / orders_cnt
margin_pct = (total_profit / total_rev) * 100
return_pct = (all_tx["order_status"] == "Returned").mean() * 100
repeat_pct = (completed.groupby("customer_id")["transaction_id"].count() > 1).mean() * 100

kpi_df = pd.DataFrame([
    {"kpi": "Net Revenue (KES)", "value": round(total_rev, 2), "definition": "Sum of gross_revenue_kes for Completed orders."},
    {"kpi": "Gross Profit (KES)", "value": round(total_profit, 2), "definition": "Sum of gross_profit_kes for Completed orders."},
    {"kpi": "Gross Margin (%)", "value": round(margin_pct, 2), "definition": "Gross Profit / Net Revenue * 100 for Completed orders."},
    {"kpi": "Average Order Value (KES)", "value": round(aov, 2), "definition": "Net Revenue / Completed Orders."},
    {"kpi": "Repeat Customer Rate (%)", "value": round(repeat_pct, 2), "definition": "Share of active customers with >= 2 Completed orders."},
    {"kpi": "Return Rate (%)", "value": round(return_pct, 2), "definition": "Share of all cleaned transactions with order_status = Returned."},
])
display(kpi_df)

gold = completed.loc[completed["loyalty_tier"] == "Gold", "gross_revenue_kes"]
bronze = completed.loc[completed["loyalty_tier"] == "Bronze", "gross_revenue_kes"]
u_stat, p_val = stats.mannwhitneyu(gold, bronze, alternative="greater")
print(f"Gold median: {gold.median():,.2f} | Bronze median: {bronze.median():,.2f} | U={u_stat:,.1f} | p={p_val:.4e}")

os.makedirs("../reports", exist_ok=True)
branch_q = completed.groupby(["branch", "quarter"], as_index=False).agg(
    completed_orders=("transaction_id", "count"),
    units_sold=("quantity", "sum"),
    net_revenue_kes=("gross_revenue_kes", "sum"),
    gross_profit_kes=("gross_profit_kes", "sum"),
    avg_order_value_kes=("gross_revenue_kes", "mean"),
).round(2)

cat_b = completed.groupby(["category", "branch"], as_index=False).agg(
    completed_orders=("transaction_id", "count"),
    net_revenue_kes=("gross_revenue_kes", "sum"),
    gross_profit_kes=("gross_profit_kes", "sum"),
).round(2)
cat_b["gross_margin_pct"] = (cat_b["gross_profit_kes"] / cat_b["net_revenue_kes"] * 100).round(2)

out_xlsx = "../reports/stakeholder_summary.xlsx"
with pd.ExcelWriter(out_xlsx, engine="openpyxl") as writer:
    kpi_df.to_excel(writer, sheet_name="KPI_Scorecard", index=False)
    branch_q.to_excel(writer, sheet_name="Branch_Quarter", index=False)
    cat_b.to_excel(writer, sheet_name="Category_Branch", index=False)
    for sheet in ["Branch_Quarter", "Category_Branch"]:
        ws = writer.sheets[sheet]
        ws.auto_filter.ref = ws.dimensions

print(f"Saved {out_xlsx}")
